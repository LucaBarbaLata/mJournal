{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@core/*": ["./src/core/*"] }
  },
  "include": [
    "src/core/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "tests/unit/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
